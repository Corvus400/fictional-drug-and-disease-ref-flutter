{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "dependencyDashboard": true,
  "pinDigests": true,
  "enabledManagers": [
    "pub",
    "gradle",
    "cocoapods"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "automerge": false,
  "packageRules": [
    {
      "description": "Group Dart and Flutter package updates",
      "matchManagers": [
        "pub"
      ],
      "groupName": "Dart and Flutter packages"
    },
    {
      "description": "Flutter 3.41.5 の flutter_test が meta 1.17.0 を固定しており analyzer >=10.0.2 は meta ^1.18.0 を要求して解決不能のため保留する。Flutter SDK 更新などで解決したら本ルールを削除する",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "analyzer"
      ],
      "allowedVersions": "<10.0.2"
    },
    {
      "description": "Ignore Flutter SDK gradle plugin (bundled with Flutter SDK, not published to Maven)",
      "matchManagers": [
        "gradle"
      ],
      "matchDepNames": [
        "dev.flutter.flutter-plugin-loader"
      ],
      "enabled": false
    }
  ],
  "prBodyDefinitions": {
    "Source": "{{#if sourceUrl}}[{{{sourceUrl}}}]({{{sourceUrl}}}){{else}}—{{/if}}"
  },
  "prBodyColumns": [
    "Package",
    "Change",
    "Age",
    "Confidence",
    "Source"
  ]
}
